# Ravora MVP Framework Configuration Template
# Duplicate this file to .env and fill in your developer credentials.

# 1. Server Configuration
PORT=3000
JWT_SECRET=specify_a_long_cryptographically_secure_random_hash_string

# 2. Supabase Settings (Unified Auth & PostgreSQL Single Source of Truth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_admin_service_role_key

# 3. Email Provider (Resend API or SendGrid API)
EMAIL_PROVIDER=resend             # options: 'resend', 'sendgrid', or 'console' (sandbox)
EMAIL_FROM=no-reply@yourdomain.com
RESEND_API_KEY=re_your_resend_key
SENDGRID_API_KEY=SG.your_sendgrid_key

# 4. SMS Provider (Twilio REST API)
SMS_PROVIDER=twilio               # options: 'twilio' or 'console' (sandbox)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

# 5. WhatsApp Secondary Route
WHATSAPP_ENABLED=true             # options: 'true' or 'false'
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
